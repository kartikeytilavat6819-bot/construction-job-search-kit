{
  "manifest_version": 3,
  "name": "career-ops Autofill",
  "version": "2.0.0",
  "description": "Fills job applications from your profile while you watch, and attaches the tailored resume and cover letter from career-ops. Never submits.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "career-ops Autofill",
    "default_popup": "popup.html"
  }
}